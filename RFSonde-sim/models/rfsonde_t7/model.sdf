<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Gremsy T7 layout: the pan motor under the mount plate, the pan arm back and down to the
       roll motor (axis forward), the roll arm round to the tilt motor on the right (axis left/right),
       the payload in the tilt cradle.  Every link frame is x forward, y left, z up at zero joint
       angles; the three axes cross at the payload centre of mass, so the payload is balanced.

       Joint signs are the T7 firmware's: tilt + = camera down (about +y), roll + = right side down
       (about +x), pan + = nose right (about -z).  The stops are where the firmware's home
       calibration looks for them (app/home_calib.c): tilt -150 deg (camera up and over),
       roll +-80.5 deg, pan +-347 deg.

       The masses are light (0.55 kg) so the Iris still hovers; the inertias are those of the
       RFSonde horn and arms, matched to the T7 twin's motor model (T7_twin/sim/plant.c built-in
       plant: 0.004 / 0.008 / 0.015 kg m^2 about tilt / roll / pan).  Gimbal links have no
       collision geometry: the gimbal hangs below the Iris landing gear. -->
  <model name="rfsonde_t7">
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>0.00005</ixx><iyy>0.00005</iyy><izz>0.00008</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="mount_plate">
        <pose>0 0 -0.005 0 0 0</pose>
        <geometry><box><size>0.12 0.09 0.01</size></box></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="pan_motor">
        <pose>0 0 -0.025 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.6 0.6 0.62 1</diffuse></material>
      </visual>
    </link>

    <link name="yaw_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>-0.06 0 -0.07 0 0 0</pose>
        <mass>0.10</mass>
        <inertia><ixx>0.003</ixx><iyy>0.004</iyy><izz>0.005</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="pan_arm_top">
        <pose>-0.055 0 -0.045 0 0 0</pose>
        <geometry><box><size>0.13 0.03 0.012</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="pan_arm_down">
        <pose>-0.115 0 -0.09 0 0 0</pose>
        <geometry><box><size>0.012 0.03 0.10</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <joint name="pan_joint" type="revolute">
      <parent>base_link</parent>
      <child>yaw_link</child>
      <pose relative_to="__model__">0 0 -0.04 0 0 0</pose>
      <axis>
        <xyz expressed_in="__model__">0 0 -1</xyz>
        <limit><lower>-6.0563</lower><upper>6.0563</upper><effort>5</effort></limit>
        <dynamics><damping>0.003</damping><friction>0.006</friction></dynamics>
      </axis>
    </joint>

    <link name="roll_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>-0.04 0 -0.14 0 0 0</pose>
        <mass>0.10</mass>
        <inertia><ixx>0.003</ixx><iyy>0.002</iyy><izz>0.003</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="roll_motor">
        <pose>-0.105 0 -0.14 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.03</radius><length>0.025</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.6 0.6 0.62 1</diffuse></material>
      </visual>
      <visual name="roll_arm_back">
        <pose>-0.095 -0.045 -0.14 0 0 0</pose>
        <geometry><box><size>0.012 0.09 0.03</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="roll_arm_side">
        <pose>-0.045 -0.09 -0.14 0 0 0</pose>
        <geometry><box><size>0.10 0.012 0.03</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <joint name="roll_joint" type="revolute">
      <parent>yaw_link</parent>
      <child>roll_link</child>
      <pose relative_to="__model__">-0.105 0 -0.14 0 0 0</pose>
      <axis>
        <xyz expressed_in="__model__">1 0 0</xyz>
        <limit><lower>-1.4050</lower><upper>1.4050</upper><effort>5</effort></limit>
        <dynamics><damping>0.002</damping><friction>0.004</friction></dynamics>
      </axis>
    </joint>

    <!-- payload: the IMU board sits on the camera plate (GremsyT7Plugin imu_link) -->
    <link name="payload_link">
      <pose>0 0 -0.14 0 0 0</pose>
      <inertial>
        <mass>0.30</mass>
        <inertia><ixx>0.005</ixx><iyy>0.004</iyy><izz>0.005</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="tilt_motor">
        <pose>0 -0.075 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.028</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.6 0.6 0.62 1</diffuse></material>
      </visual>
      <visual name="cradle">
        <geometry><box><size>0.11 0.12 0.012</size></box></geometry>
        <pose>0 0 -0.045 0 0 0</pose>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="sensor_box">
        <pose>-0.02 0 -0.01 0 0 0</pose>
        <geometry><box><size>0.09 0.07 0.06</size></box></geometry>
        <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material>
      </visual>
      <visual name="horn">
        <!-- horn antenna, aperture at antenna_rf -->
        <pose>0.07 0 0 0 1.5708 0</pose>
        <geometry><cone><radius>0.06</radius><length>0.08</length></cone></geometry>
        <material><ambient>0.8 0.55 0.2 1</ambient><diffuse>0.8 0.55 0.2 1</diffuse></material>
      </visual>

      <!-- RFSonde frame triad and pointing visuals (visual only), as on models/rfsonde_gimbal:
           X red = boresight with a 300 m laser line and a 30 deg / 20 m beam cone, Y green left,
           Z blue up (vertical polarization).  visibility_flags 0x2 hides them from the camera. -->
      <visual name="pointer_axis_x_shaft">
        <pose relative_to="antenna_rf">0.5 0 0 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>1.0</length></cylinder></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><emissive>0.6 0 0 1</emissive></material>
        <cast_shadows>false</cast_shadows><visibility_flags>2</visibility_flags>
      </visual>
      <visual name="pointer_axis_x_head">
        <pose relative_to="antenna_rf">1.06 0 0 0 1.5708 0</pose>
        <geometry><cone><radius>0.035</radius><length>0.12</length></cone></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><emissive>0.6 0 0 1</emissive></material>
        <cast_shadows>false</cast_shadows><visibility_flags>2</visibility_flags>
      </visual>
      <visual name="pointer_axis_y_shaft">
        <pose relative_to="antenna_rf">0 0.3 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.6</length></cylinder></geometry>
        <material><ambient>0 0.85 0 1</ambient><diffuse>0 0.85 0 1</diffuse><emissive>0.0 0.5 0.0 1</emissive></material>
        <cast_shadows>false</cast_shadows><visibility_flags>2</visibility_flags>
      </visual>
      <visual name="pointer_axis_y_head">
        <pose relative_to="antenna_rf">0 0.66 0 -1.5708 0 0</pose>
        <geometry><cone><radius>0.035</radius><length>0.12</length></cone></geometry>
        <material><ambient>0 0.85 0 1</ambient><diffuse>0 0.85 0 1</diffuse><emissive>0.0 0.5 0.0 1</emissive></material>
        <cast_shadows>false</cast_shadows><visibility_flags>2</visibility_flags>
      </visual>
      <visual name="pointer_axis_z_shaft">
        <pose relative_to="antenna_rf">0 0 0.3 0 0 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.6</length></cylinder></geometry>
        <material><ambient>0.1 0.3 1 1</ambient><diffuse>0.1 0.3 1 1</diffuse><emissive>0.1 0.2 0.6 1</emissive></material>
        <cast_shadows>false</cast_shadows><visibility_flags>2</visibility_flags>
      </visual>
      <visual name="pointer_axis_z_head">
        <pose relative_to="antenna_rf">0 0 0.66 0 0 0</pose>
        <geometry><cone><radius>0.035</radius><length>0.12</length></cone></geometry>
        <material><ambient>0.1 0.3 1 1</ambient><diffuse>0.1 0.3 1 1</diffuse><emissive>0.1 0.2 0.6 1</emissive></material>
        <cast_shadows>false</cast_shadows><visibility_flags>2</visibility_flags>
      </visual>
      <visual name="pointer_origin">
        <pose relative_to="antenna_rf">0 0 0 0 0 0</pose>
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>0.5 0.5 0.5 1</emissive></material>
        <cast_shadows>false</cast_shadows><visibility_flags>2</visibility_flags>
      </visual>
      <visual name="pointer_laser">
        <pose relative_to="antenna_rf">151 0 0 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>300</length></cylinder></geometry>
        <material><ambient>1 0.1 0.1 1</ambient><diffuse>1 0.1 0.1 1</diffuse><emissive>1 0.1 0.1 1</emissive></material>
        <transparency>0.4</transparency>
        <cast_shadows>false</cast_shadows><visibility_flags>2</visibility_flags>
      </visual>
      <visual name="pointer_beam_cone">
        <pose relative_to="antenna_rf">10.000 0 0 0 -1.5708 0</pose>
        <geometry><cone><radius>5.359</radius><length>20.000</length></cone></geometry>
        <material><ambient>1 0.85 0.1 1</ambient><diffuse>1 0.85 0.1 1</diffuse><emissive>0.4 0.3 0 1</emissive></material>
        <transparency>0.8</transparency>
        <cast_shadows>false</cast_shadows><visibility_flags>2</visibility_flags>
      </visual>

      <sensor name="camera" type="camera">
        <gz_frame_id>payload_link</gz_frame_id>
        <pose>0.08 0 0.04 0 0 0</pose>
        <camera>
          <visibility_mask>4294967293</visibility_mask>
          <horizontal_fov>2.0</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.05</near><far>15000</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>1</visualize>
        <plugin filename="CameraZoomPlugin" name="CameraZoomPlugin">
          <max_zoom>125.0</max_zoom>
          <slew_rate>0.42514285714</slew_rate>
        </plugin>
        <plugin name="GstCameraPlugin" filename="GstCameraPlugin">
          <udp_host>127.0.0.1</udp_host>
          <udp_port>5600</udp_port>
          <use_basic_pipeline>true</use_basic_pipeline>
          <use_cuda>false</use_cuda>
        </plugin>
      </sensor>
    </link>
    <joint name="tilt_joint" type="revolute">
      <parent>roll_link</parent>
      <child>payload_link</child>
      <pose relative_to="__model__">0 -0.075 -0.14 0 0 0</pose>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-2.6180</lower><upper>2.6180</upper><effort>5</effort></limit>
        <dynamics><damping>0.0015</damping><friction>0.004</friction></dynamics>
      </axis>
    </joint>

    <!-- RFSonde antenna reference frame: x boresight, y left, z up (vertical polarization) at
         neutral on a level vehicle.  Move it to your antenna phase centre; the visuals follow. -->
    <frame name="antenna_rf" attached_to="payload_link">
      <pose relative_to="payload_link">0.11 0 0 0 0 0</pose>
    </frame>

    <plugin filename="GremsyT7Plugin" name="GremsyT7Plugin">
      <tilt_joint>tilt_joint</tilt_joint>
      <roll_joint>roll_joint</roll_joint>
      <pan_joint>pan_joint</pan_joint>
      <joint_sign>1 1 1</joint_sign>
      <imu_link>payload_link</imu_link>
      <base_link>base_link</base_link>
      <twin_addr>127.0.0.1</twin_addr>
      <twin_port>9150</twin_port>
      <timeout_ms>1000</timeout_ms>
    </plugin>
    <!-- actual joint angles (rad) on /world/<world>/model/rfsonde_iris_t7/model/gimbal/joint_state -->
    <plugin filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher"/>
  </model>
</sdf>
