<?xml version="1.0" ?>
<model>
  <name>RFSonde Gremsy T7 (digital twin)</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <description>
    Three-axis gimbal in the layout of the Gremsy T7 (pan, roll, tilt motors) carrying the
    RFSonde antenna.  The joints are driven by the T7 digital twin (the real T7 firmware on
    simulated hardware) through the GremsyT7Plugin; nothing else controls them.
  </description>
</model>
