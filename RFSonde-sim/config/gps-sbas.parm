# RFSonde SITL GPS profile: GNSS with SBAS corrections (u-blox ZED-F9P class: ~1.0 m CEP).
# Load the same way as gps-standard.parm (see that file for the model description).
# Site and receiver, the same in every profile (see gps-rtk.parm)
SIM_GEODESY      1
SIM_GPS_GEOID    -27.33
SIM_GPS1_LAG_MS  0
SIM_GPS2_LAG_MS  0
SIM_GPS_LAG_RND  90
SIM_GPS_HBIAS    0.8
SIM_GPS_HWN      0.25
SIM_GPS_VBIAS    1.3
SIM_GPS_VWN      0.3
SIM_GPS_BTAU     60
SIM_GPS_VELNSE   0.05
# RTK-only terms off (they stay set when switching from gps-rtk.parm)
SIM_GPS_FHBIAS   0
SIM_GPS_FVBIAS   0
SIM_GPS_PPM      0
SIM_GPS_VPPM     0
SIM_GPS_PCO_V    0
SIM_GPS_CONV     0
SIM_GPS_FLTACC   0
SIM_GPS_FIXLOSS  0
SIM_GPS1_ACC     0.3
SIM_GPS2_ACC     0.3

EK3_SRC1_POSZ    3
EK3_POSNE_M_NSE  0.5
EK3_VELNE_M_NSE  0.3
EK3_VELD_M_NSE   0.5
